# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional: comma-separated list if you serve the frontend from more than
# one place (e.g. a dev server + a deployed URL). Falls back to CLIENT_URL.
# A frontend HTML file opened directly via file:// is always allowed too.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# MongoDB (use MongoDB Atlas free tier, or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/chocoanalytics

# JWT
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Email (used for verification / password reset — e.g. Gmail app password or Mailtrap/SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="ChocoAnalytics <no-reply@chocoanalytics.io>"

# First admin account (created by seed script if it doesn't exist)
SEED_ADMIN_EMAIL=admin@chocoanalytics.io
SEED_ADMIN_PASSWORD=ChangeMe123!
